# 【开发】环境变量

# 应用部署基础路径（如部署在子目录 /admin，则设置为 /admin/）
VITE_BASE_URL = /

# API 直接使用 /api；运行中的页面优先读取 public/runtime-config.js。
VITE_API_URL = /

# 代理目标地址（开发环境通过 Vite 代理转发请求到此地址，解决跨域问题）    http://10.148.75.230:8087/   http://localhost:8089/
VITE_API_PROXY_URL = http://localhost:8087/

# WebSocket 基础地址；默认与 API 前缀保持一致。
VITE_WS_URL = /

# WebSocket 独立代理目标，不与 HTTP API 代理共用配置
VITE_WS_PROXY_URL = ws://localhost:8087/

# Delete console
VITE_DROP_CONSOLE = false
